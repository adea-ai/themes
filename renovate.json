{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":semanticPrefixFixDepsChoreOthers"],
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "rebaseWhen": "behind-base-branch",
  "pruneStaleBranches": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "This repository is the source of the @adea-ai/themes package: never self-update an internal package.",
      "matchPackagePatterns": ["^@adea-ai/"],
      "enabled": false
    },
    {
      "description": "GitHub Actions version bumps automerge once validation passes.",
      "matchDepTypes": ["action"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Non-major external dependency updates automerge once the validation gates pass.",
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "schedule": ["after 8am and before 8pm every weekday"]
    }
  ]
}
